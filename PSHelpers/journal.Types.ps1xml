<?xml version="1.0" encoding="utf-8"?>

<Types>
  <Type>
    <Name>JournalEntry</Name>
    <Members>
      <ScriptProperty>
        <Name>Timestamp</Name>
        <GetScriptBlock>
          [datetime]::UnixEpoch.AddMicroseconds($this.__REALTIME_TIMESTAMP)
        </GetScriptBlock>
      </ScriptProperty>
      <AliasProperty>
        <Name>Hostname</Name>
        <ReferencedMemberName>_HOSTNAME</ReferencedMemberName>
      </AliasProperty>
      <ScriptProperty>
        <Name>SyslogId</Name>
        <GetScriptBlock>
          "$($this.SYSLOG_IDENTIFIER)[$($this._PID)]"
        </GetScriptBlock>
      </ScriptProperty>
      <MemberSet>
        <Name>PSStandardMembers</Name>
        <Members>
          <PropertySet>
            <Name>DefaultDisplayPropertySet</Name>
            <ReferencedProperties>
              <Name>Timestamp</Name>
              <Name>Hostname</Name>
              <Name>SyslogId</Name>
              <Name>Message</Name>
            </ReferencedProperties>
          </PropertySet>
          <NoteProperty>
            <Name>DefaultDisplayProperty</Name>
            <Value>Name</Value>
          </NoteProperty>
          <PropertySet>
            <Name>DefaultKeyPropertySet</Name>
            <ReferencedProperties>
              <Name>Timestamp</Name>
            </ReferencedProperties>
          </PropertySet>
        </Members>
      </MemberSet>
    </Members>
  </Type>
</Types>
