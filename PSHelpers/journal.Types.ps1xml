  <Type>
    <Name>JournalEntry</Name>
    <Members>
      <ScriptProperty>
        <Name>Timestamp</Name>
        <GetScriptBlock>
          [datetime]::UnixEpoch.AddMicroseconds($this.__REALTIME_TIMESTAMP)
        </GetScriptBlock>
      </ScriptProperty>
      <AliasProperty>
        <Name>Hostname</Name>
        <ReferencedMemberName>_HOSTNAME</ReferencedMemberName>
      </AliasProperty>
      <ScriptProperty>
        <Name>SyslogId</Name>
