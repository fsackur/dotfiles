<?xml version="1.0" encoding="utf-8"?>
<!-- Get-FormatData -TypeName System.IO.FileInfo | Export-FormatData -Path ./Filesystem.Format.ps1xml -->
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>Short</Name>
      <ViewSelectedBy>
        <TypeName>JournalEntry</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>Timestamp</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Hostname</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>SyslogId</Label>
            <Width>24</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Message</Label>
            <Alignment>Left</Alignment>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <Wrap />
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>Timestamp</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Hostname</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>SyslogId</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>
                  if ($null -eq $_.PRIORITY -or $_.PRIORITY -gt 4) {
                    $_.MESSAGE
                  } elseif ($_.PRIORITY -eq 4) {
                    "$($PSStyle.Formatting.Warning)$($_.MESSAGE)`e[0m"
                  } else {
                    "$($PSStyle.Formatting.Error)$($_.MESSAGE)`e[0m"
                  }
                </ScriptBlock>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>

    <View>
      <Name>JournalValue</Name>
      <ViewSelectedBy>
        <TypeName>JournalValue</TypeName>
      </ViewSelectedBy>
      <GroupBy>
        <PropertyName>Field</PropertyName>
      </GroupBy>
      <CustomControl>
        <CustomEntries>
          <CustomEntry>
            <CustomItem>
              <ExpressionBinding>
                 <ScriptBlock>$_</ScriptBlock>
              </ExpressionBinding>
            </CustomItem>
          </CustomEntry>
        </CustomEntries>
      </CustomControl>
    </View>

    <View>
      <Name>JournalUnit</Name>
      <ViewSelectedBy>
        <TypeName>JournalUnit</TypeName>
      </ViewSelectedBy>
      <GroupBy>
        <PropertyName>UnitType</PropertyName>
      </GroupBy>
      <CustomControl>
        <CustomEntries>
          <CustomEntry>
            <CustomItem>
              <ExpressionBinding>
                <ScriptBlock>$_</ScriptBlock>
              </ExpressionBinding>
            </CustomItem>
          </CustomEntry>
        </CustomEntries>
      </CustomControl>
    </View>
  </ViewDefinitions>
</Configuration>
